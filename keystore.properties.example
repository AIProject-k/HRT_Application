# Copy this file to `keystore.properties` (git-ignored) to sign the release
# build with your own key. Generate a key first:
#
#   keytool -genkeypair -v -keystore hormonelog-release.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias hormonelog
#
# Then fill in the values below. Paths are relative to the project root.

storeFile=hormonelog-release.jks
storePassword=CHANGE_ME
keyAlias=hormonelog
keyPassword=CHANGE_ME
