<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the device: no cloud backup, no device-to-device transfer. A backup file the
     user makes themselves (내 정보 › 백업·복원·보안) is the only way records move. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
